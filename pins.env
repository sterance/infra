# Versions infra itself pins, read by bootstrap.sh (servers) and deploy-backend.yml
# (GitHub Actions, at the caller's infra_ref). The weekly dependency check
# (.github/updates.yml) proposes updates as PRs. Plain KEY=value lines only:
# the workflow parses this file, it doesn't run it.

# cloudflared: the stack's tunnel container (cloudflare/cloudflared:<version>) and the
# binary deploy-backend.yml downloads for SSH through tunnels (checked against the SHA-256).
CLOUDFLARED_VERSION=2026.11.0
CLOUDFLARED_LINUX_AMD64_SHA256=51f7c68b57ed7269164075d7e789efce5b59355982f06392deeb037d982a51fd

# The throwaway container deploy-backend.yml probes health_path from, on the target.
PROBE_IMAGE=curlimages/curl:8.11.1
