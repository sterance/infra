# Copy to config.env (git-ignored) and fill in. Used by bootstrap.sh on servers
# and by the scripts in bin/ on your laptop. Contains no secrets.

# Your Cloudflare zone, e.g. example.com
DOMAIN=example.com

# GitHub user or organisation that owns your repos (and this infra repo)
GH_OWNER=your-github-user

# This repo, used by app repos to call the shared workflows
INFRA_REPO=${GH_OWNER}/infra

# Public OpenBao address (always served through the Cloudflare Tunnel)
BAO_ADDR=https://bao.${DOMAIN}

# Pin a real release: https://github.com/openbao/openbao/releases
BAO_VERSION=2.7.2

# Where the stack and apps live on every server
STACK_DIR=/opt/stack
APPS_DIR=/opt/apps

# Name for this machine's Cloudflare Tunnel (one tunnel per machine). Defaults to the hostname.
# TUNNEL_NAME=home

# Linux users on your servers you SSH in as with OpenBao-signed certs.
# Comma-separated, no spaces: ubuntu,alice
SSH_ADMIN_USERS=ubuntu

# Your OpenBao login name (userpass)
BAO_ADMIN_USER=me

# Snapshot retention on the server, in days (Backblaze keeps its own history)
SNAPSHOT_KEEP_DAYS=14

# Dependency updates (onboard-repo.sh --updates): the slug of the GitHub App that opens the
# update PRs (from its URL, github.com/apps/<slug>). Its key lives in OpenBao, never here.
# UPDATES_APP=my-updates
